# ==============================================================================
# LEMail E2E & IMAP QA Test Configuration (.env.test)
# ==============================================================================
# ※ 본 파일은 Playwright + imapflow 기반 E2E QA 전용 설정입니다.
#   배포 및 서비스 런타임용 루트 .env 파일과는 완전히 분리되어 관리됩니다.
#   사용 방법: 본 파일을 .env.test 로 복사한 뒤 테스트 계정 정보를 입력하세요.
# ==============================================================================

# 1. 웹메일 접속 URL
# - 로컬 개발 환경: http://localhost:9000
# - 운영 환경 예시: https://mail.example.com
WEBMAIL_URL=http://localhost:9000

# 2. 테스트 사용자 계정 (발송 및 본인 수신함 검증용)
TEST_USER_EMAIL=
TEST_USER_PASS=

# 3. IMAP 서버 접속 정보
# - 로컬 개발 환경: 127.0.0.1 / 1143 (IMAP_SECURE=false) 또는 1993 (IMAP_SECURE=true)
# - 운영 환경 예시: mail.example.com / 993 (IMAP_SECURE=true)
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_SECURE=false
# 자체 서명 인증서 환경에서는 false, 운영 공인 인증서 환경에서는 true 권장
IMAP_TLS_REJECT_UNAUTHORIZED=false

# 4. 폴링 및 타임아웃 (운영 네트워크 지연 환경에서는 값을 늘려 사용)
IMAP_POLL_TIMEOUT_MS=20000
IMAP_POLL_INTERVAL_MS=1500
E2E_TIMEOUT_MS=60000

# 5. HTTPS 자체 서명 인증서 허용 여부 (운영 공인 인증서 환경에서는 false)
E2E_IGNORE_HTTPS_ERRORS=false
