# Server & Concurrency Configuration
PORT=3000
WORKER_CONCURRENCY=5

# SMTP Server Configuration
SMTP_PORT=2525
MAIL_SPOOL_DIR=./mail-spool
MAIL_ARCHIVE_DIR=./mail-archive
MAIL_SPOOL_CLEANUP=false
SMTP_USE_PROXY=false
SMTP_MAX_CLIENTS=100
MAILBOX_CACHE_TTL=60

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3300
DB_USERNAME=lemail
DB_PASSWORD=your_mysql_password
DB_DATABASE=lemaildb
DB_POOL_SIZE=20

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Haraka Outbound MTA Configuration
HARAKA_HOST=127.0.0.1
HARAKA_PORT=2526
HARAKA_ENABLED=true

# Outbound SMTP Relay (Smarthost) Configuration
# 외부 릴레이(Gmail SMTP, AWS SES, 사내 릴레이 등) 활성화 시 true로 변경
SMTP_RELAY_ENABLED=false
SMTP_RELAY_HOST=smtp.gmail.com
SMTP_RELAY_PORT=587
SMTP_RELAY_SECURE=false
SMTP_RELAY_USER=your_email@gmail.com
SMTP_RELAY_PASS=your_app_password
SMTP_RELAY_REJECT_UNAUTHORIZED=false
