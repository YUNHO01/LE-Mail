# ==============================================================================
# LEMail Bootstrap Configuration Example (초기 설치 환경 템플릿)
# ==============================================================================
# ※ 본 파일(.env)은 초기 설치 및 인프라 연결에 필요한 필수 설정만 포함합니다.
#   스마트호스트 릴레이, 작업자 동시성 등 세부 운영 설정은
#   최초 기동 후 관리자 웹 콘솔(/admin/settings)에서 GUI로 안전하게 구성됩니다.
# ==============================================================================

# 1. API & Web Server
PORT=9200
WEB_PORT=9000

# 2. MySQL Database Connection (부트스트랩 필수)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=lemail
DB_PASSWORD=your_mysql_password
DB_DATABASE=lemaildb

# 3. Redis Infrastructure Connection (작업 큐 & 캐시 - requirepass 일치)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# 4. ClamAV Antivirus Daemon (실시간 첨부파일 바이러스 검사)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_ENABLED=true
CLAMAV_TIMEOUT_MS=3000

# 5. IMAP Service TLS Certificates (공인 인증서 경로)
IMAP_PORT=1143
IMAPS_PORT=1993
IMAP_STARTTLS=true
# IMAP_TLS_CERT=/etc/letsencrypt/live/mail.yourdomain.com/fullchain.pem
# IMAP_TLS_KEY=/etc/letsencrypt/live/mail.yourdomain.com/privkey.pem

# 6. Default System Administrator (최초 부트스트랩 시 1회 시딩)
DEFAULT_ADMIN_EMAIL=admin@lineedge.com
DEFAULT_ADMIN_PASSWORD=admin1234!
DEFAULT_ADMIN_NAME=시스템관리자

# 7. Security & Master Encryption Key
JWT_SECRET=lemail_super_secret_jwt_key_2026!
JWT_EXPIRES_IN=1d
# 32바이트(64자리 Hex) 마스터 대칭키 (비워두면 최초 실행 시 .encryption_key 자동 생성)
APP_ENCRYPTION_KEY=
