# ==============================================================================
# LEMail Bootstrap Configuration Example (초기 설치 환경 템플릿)
# ==============================================================================
# ※ 본 파일(.env)은 초기 설치 및 인프라 연결에 필요한 필수 설정만 포함합니다.
#   API(9200) 및 Web(9000) 포트 설정은 ecosystem.config.js 에서 각 서비스별로 설정됩니다.
#   스마트호스트 릴레이, 작업자 동시성 등 세부 운영 설정은
#   최초 기동 후 관리자 웹 콘솔(/admin/settings)에서 GUI로 안전하게 구성됩니다.
# ==============================================================================

# 1. MySQL Database Connection (부트스트랩 필수)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=lemail
DB_PASSWORD=your_mysql_password
DB_DATABASE=lemaildb

# 2. Redis Infrastructure Connection (작업 큐 & 캐시 - requirepass 일치)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# 3. ClamAV Antivirus Daemon (실시간 첨부파일 바이러스 검사 - 최소 4GB RAM 권장, 저사양 시 false 설정)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_ENABLED=true
CLAMAV_TIMEOUT_MS=3000

# 4. IMAP Service TLS Certificates (LEMail 전용 certs 디렉터리 경로 권장)
IMAP_PORT=1143
IMAPS_PORT=1993
IMAP_STARTTLS=true
# IMAP_TLS_CERT=/opt/lemail/certs/fullchain.pem
# IMAP_TLS_KEY=/opt/lemail/certs/privkey.pem

# 5. Default System Administrator (최초 부트스트랩 시 1회 시딩)
DEFAULT_ADMIN_EMAIL=admin@lineedge.com
DEFAULT_ADMIN_PASSWORD=admin1234!
DEFAULT_ADMIN_NAME=시스템관리자

# 6. Security & Master Encryption Key
JWT_SECRET=lemail_super_secret_jwt_key_2026!
JWT_EXPIRES_IN=1d
# 32바이트(64자리 Hex) 마스터 대칭키 (비워두면 최초 실행 시 .encryption_key 자동 생성)
APP_ENCRYPTION_KEY=

# 7. Shared Disk Storage Paths (모든 마이크로서비스 공통 중앙 저장소 절대경로 권장)
MAIL_SPOOL_DIR=/opt/lemail/mail-spool
MAIL_ARCHIVE_DIR=/opt/lemail/mail-archive
MAIL_ATTACHMENT_DIR=/opt/lemail/mail-attachments
LICENSE_FILE_PATH=/opt/lemail/license/lemail-license.lic
