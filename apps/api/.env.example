# ==============================================================================
# LEMail Bootstrap Configuration Example (초기 설치 환경 템플릿)
# ==============================================================================
# ※ 본 파일(.env)은 초기 설치 및 데이터베이스 연결에 필요한 필수 설정만 포함합니다.
#   SMTP 인바운드 포트, 스마트호스트 릴레이, 작업자 동시성 등 모든 운영 설정은
#   최초 기동 후 관리자 웹 콘솔(/admin/settings)에서 GUI로 안전하게 구성됩니다.
# ==============================================================================

# 1. API Core Server
PORT=9200

# 2. MySQL Database Connection (부트스트랩 필수)
DB_HOST=127.0.0.1
DB_PORT=3300
DB_USERNAME=lemail
DB_PASSWORD=your_mysql_password
DB_DATABASE=lemaildb

# 3. Redis Infrastructure Connection (작업 큐 & 캐시)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# 4. Default System Administrator (최초 부트스트랩 시 1회 시딩)
DEFAULT_ADMIN_EMAIL=admin@lineedge.com
DEFAULT_ADMIN_PASSWORD=admin1234!
DEFAULT_ADMIN_NAME=시스템관리자

# 5. Security & Master Encryption Key
JWT_SECRET=lemail_super_secret_jwt_key_2026!
JWT_EXPIRES_IN=1d
# 32바이트(64자리 Hex) 마스터 대칭키 (비워두면 최초 실행 시 .encryption_key 자동 생성)
APP_ENCRYPTION_KEY=
