# Server & Concurrency Configuration
PORT=9200
WORKER_CONCURRENCY=5

# SMTP Server Configuration
SMTP_PORT=2525
MAIL_SPOOL_DIR=./mail-spool
MAIL_ARCHIVE_DIR=./mail-archive
MAIL_SPOOL_CLEANUP=false
SMTP_USE_PROXY=false
SMTP_MAX_CLIENTS=100
MAILBOX_CACHE_TTL=60

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3300
DB_USERNAME=lemail
DB_PASSWORD=your_mysql_password
DB_DATABASE=lemaildb
DB_POOL_SIZE=20

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Default System Administrator & JWT
DEFAULT_ADMIN_EMAIL=admin@lineedge.com
DEFAULT_ADMIN_PASSWORD=admin1234!
DEFAULT_ADMIN_NAME=시스템관리자
JWT_SECRET=lemail_super_secret_jwt_key_2026!
JWT_EXPIRES_IN=1d
