  "info": {
    "title": "LEMail Server REST API",
    "description": "LEMail SMTP 메일 서버 관리자 및 웹메일 사용자용 REST API 명세서",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Mailboxes",
      "description": "사서함 및 도메인 관리"
    },
    {
      "name": "Mails",
      "description": "메일 목록/상세 조회 및 첨부파일/EML 다운로드"
    },
    {
      "name": "Monitoring",
      "description": "BullMQ 큐 현황 및 시스템 자원 모니터링"
    },
    {
      "name": "Auth",
      "description": "사용자 인증 및 로그인"
    },
    {
      "name": "Users",
      "description": "사용자 계정 관리"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@lineedge.com",
            "description": "이메일 계정"
          },
          "password": {
            "type": "string",
            "example": "admin1234!",
            "description": "비밀번호"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateDomainDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "lineedge.com",
            "description": "도메인 이름"
          },
          "description": {
            "type": "string",
            "example": "본사 공식 메일 도메인",
            "description": "도메인 설명"
          },
          "isDefault": {
            "type": "boolean",
            "example": false,
            "description": "기본 도메인 여부",
            "default": false
          },
          "isActive": {
            "type": "boolean",
            "example": true,
            "description": "활성화 여부",
            "default": true
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateDomainDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "example": "변경할 설명",
            "description": "도메인 설명"
          },
          "isDefault": {
            "type": "boolean",
            "example": true,
            "description": "기본 도메인 여부"
          },
          "isActive": {
            "type": "boolean",
            "example": true,
            "description": "활성화 여부"
          }
        }
      },
      "CreateMailboxDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "이메일 전체 주소"
          },
          "domain": {
            "type": "string",
            "example": "example.com",
            "description": "메일 도메인 (생략 시 이메일에서 자동 추출)"
          },
          "isActive": {
            "type": "boolean",
            "example": true,
            "description": "활성화 여부",
            "default": true
          }
        },
        "required": [
          "email"
        ]
      },
      "UpdateMailboxDto": {
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean",
            "example": true,
            "description": "활성화 여부"
          }
        }
      },
      "SendMailAttachmentInputDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "filename": {
            "type": "string",
            "description": "파일명"
          },
          "contentType": {
            "type": "string",
            "description": "MIME 타입"
          },
          "sizeBytes": {
            "type": "number",
            "description": "파일 크기 (bytes)"
          },
          "contentBase64": {
            "type": "string",
            "description": "서버 임시 경로 또는 base64 데이터"
          }
        },
        "required": [
          "filename",
          "contentType",
          "sizeBytes"
        ]
      },
      "SendMailDto": {
        "type": "object",
        "properties": {
          "to": {
            "description": "받는 사람 이메일 주소 목록",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cc": {
            "description": "참조(Cc) 이메일 주소 목록",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bcc": {
            "description": "숨은참조(Bcc) 이메일 주소 목록",
            "type": "array",
            "items": {
