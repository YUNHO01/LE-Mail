          "Monitoring"
        ]
      }
    }
  },
  "info": {
    "title": "LEMail Server REST API",
    "description": "LEMail REST API",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateMailboxDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "이메일 전체 주소"
          },
          "domain": {
            "type": "string",
            "example": "example.com",
            "description": "메일 도메인 (생략 시 이메일에서 자동 추출)"
          },
          "isActive": {
            "type": "boolean",
            "example": true,
            "description": "활성화 여부",
            "default": true
          }
        },
        "required": [
          "email"
        ]
      },
      "UpdateMailboxDto": {
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean",
            "example": true,
            "description": "활성화 여부"
          }
        }
      }
    }
  }
}