{
  "name": "@lemail/mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) Stdio server for LEMail",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lemail-mcp-server": "./bin/lemail-mcp-server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w --preserveWatchOutput",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.4.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.3"
  }
}
