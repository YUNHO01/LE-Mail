  "info": {
    "title": "LEMail Server REST API",
    "description": "LEMail SMTP 메일 서버 관리자 및 웹메일 사용자용 REST API 명세서",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Mailboxes",
      "description": "사서함 및 도메인 관리"
    },
    {
      "name": "Mails",
      "description": "메일 목록/상세 조회 및 첨부파일/EML 다운로드"
    },
    {
      "name": "Monitoring",
      "description": "BullMQ 큐 현황 및 시스템 자원 모니터링"
    },
    {
      "name": "Auth",
      "description": "사용자 인증 및 로그인"
    },
    {
      "name": "Users",
      "description": "사용자 계정 관리"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@lineedge.com",
            "description": "이메일 계정"
          },
          "password": {
            "type": "string",
            "example": "admin1234!",
            "description": "비밀번호"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateMailboxDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "이메일 전체 주소"
          },
          "domain": {
            "type": "string",
            "example": "example.com",
            "description": "메일 도메인 (생략 시 이메일에서 자동 추출)"
          },
          "isActive": {
            "type": "boolean",
            "example": true,
            "description": "활성화 여부",
            "default": true
          }
        },
        "required": [
          "email"
        ]
      },
      "UpdateMailboxDto": {
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean",
            "example": true,
            "description": "활성화 여부"
          }
        }
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user1@lineedge.com",
            "description": "사용자 이메일"
          },
          "name": {
            "type": "string",
            "example": "홍길동",
            "description": "사용자 이름"
          },
          "password": {
            "type": "string",
            "example": "user1234!",
            "description": "초기 비밀번호"
          },
          "role": {
            "type": "string",
            "enum": [
              "SYSTEM_ADMIN",
              "USER"
            ],
            "default": "USER",
            "description": "사용자 권한 (SYSTEM_ADMIN, USER)"
          }
        },
        "required": [
          "email",
          "name",
          "password",
          "role"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "홍길동(수정)",
            "description": "사용자 이름"
          },
          "password": {
            "type": "string",
            "example": "newPassword123!",
            "description": "신규 비밀번호"
          },
          "role": {
            "type": "string",
            "enum": [
              "SYSTEM_ADMIN",
              "USER"
            ],
            "description": "사용자 역할"
          },
          "isActive": {
            "type": "boolean",
            "example": true,
            "description": "계정 활성 여부"
          }
        }
      }
    }
  }
}