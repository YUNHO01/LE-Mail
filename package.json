{
  "name": "lemail-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "api:dev": "yarn --cwd apps/api dev",
    "api:build": "yarn --cwd apps/api build",
    "web:dev": "yarn --cwd apps/web dev",
    "web:build": "yarn --cwd apps/web build",
    "haraka:dev": "node services/haraka/index.js",
    "haraka:start": "node services/haraka/index.js",
    "imap:dev": "yarn --cwd services/imap dev",
    "imap:start": "yarn --cwd services/imap start",
    "imap:build": "yarn --cwd services/imap build",
    "test:pipeline": "yarn --cwd apps/api test:pipeline",
    "test:smtp": "yarn --cwd apps/api test:smtp",
    "test:security": "yarn --cwd apps/api test:security",
    "test:api": "yarn --cwd apps/api test:api",
    "test:users": "yarn --cwd apps/api test:users",
    "test:license": "yarn --cwd apps/api ts-node test/license-security.e2e.ts",
    "license:generate-keys": "node tools/license-issuer/generate-keys.js",
    "license:issue": "node tools/license-issuer/issue-license.js",
    "license:issue:dev": "node tools/license-issuer/issue-license.js --env dev",
    "license:issue:prod": "node tools/license-issuer/issue-license.js --env prod"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
