{
  "name": "lemail-monorepo",
  "version": "1.5.8",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel --filter=!@lemail/imap",
    "dev:v1": "turbo run dev --parallel --filter=!@lemail/imap-v2",
    "build": "turbo run build",
    "build:obfuscate": "turbo run build:obfuscate",
    "lint": "turbo run lint",
    "release": "standard-version",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:dry": "standard-version --dry-run",
    "package": "node scripts/package-dist.js",
    "package:obfuscate": "node scripts/package-dist.js --obfuscate",
    "dist:package": "node scripts/package-dist.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "api:dev": "yarn --cwd apps/api dev",
    "api:build": "yarn --cwd apps/api build",
    "web:dev": "yarn --cwd apps/web dev",
    "web:build": "yarn --cwd apps/web build",
    "console:dev": "yarn --cwd apps/console dev",
    "console:build": "yarn --cwd apps/console build",
    "mobile:dev": "yarn --cwd apps/mobile dev",
    "mobile:build": "yarn --cwd apps/mobile build",
    "haraka:dev": "node services/haraka/index.js",
    "haraka:start": "node services/haraka/index.js",
    "imap:dev": "yarn --cwd services/imap dev",
    "imap:start": "yarn --cwd services/imap start",
    "imap:build": "yarn --cwd services/imap build",
    "imap:v2:dev": "node services/imap.v2/scripts/run-cargo.js dev",
    "imap:v2:build": "node services/imap.v2/scripts/run-cargo.js build",
    "imap:v2:start": "node services/imap.v2/scripts/run-cargo.js start",
    "imap:v2:test": "node services/imap.v2/scripts/run-cargo.js test",
    "test:pipeline": "yarn --cwd apps/api test:pipeline",
    "test:smtp": "yarn --cwd apps/api test:smtp",
    "test:security": "yarn --cwd apps/api test:security",
    "test:api": "yarn --cwd apps/api test:api",
    "test:users": "yarn --cwd apps/api test:users",
    "test:license": "yarn --cwd apps/api ts-node test/license-security.e2e.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "license:generate-keys": "node tools/license-issuer/generate-keys.js",
    "license:issue": "node tools/license-issuer/issue-license.js",
    "license:issue:dev": "node tools/license-issuer/issue-license.js --env dev",
    "license:issue:prod": "node tools/license-issuer/issue-license.js --env prod",
    "certs:check": "node scripts/manage-tls-certs.js --check",
    "certs:renew": "node scripts/manage-tls-certs.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "archiver": "^7.0.1",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "imapflow": "^2.12.2",
    "javascript-obfuscator": "^5.10.0",
    "selfsigned": "^5.5.0",
    "standard-version": "^9.5.0",
    "turbo": "^2.3.3"
  }
}
